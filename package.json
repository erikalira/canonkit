{
  "name": "canonkit",
  "version": "3.0.0",
  "description": "A versioned agent team for Claude Code, Codex, OpenCode and GitHub Copilot. Installs 10 core agents and 5 opt-in domain specialists, each owning a domain and classifying its own risk.",
  "type": "module",
  "bin": {
    "canonkit": "bin/cli.js"
  },
  "files": [
    "bin",
    "agents",
    "reference",
    "hooks",
    "dashboard/serve.js",
    "dashboard/package.json",
    "dashboard/execution-model.js",
    "dashboard/activity.html",
    "dashboard/THIRD_PARTY_NOTICES.md",
    "dashboard/dist",
    "skills",
    "stack-packs",
    "tools",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dashboard:build": "vite build dashboard --config dashboard/vite.config.mts",
    "dashboard:typecheck": "tsc --project dashboard/tsconfig.json --noEmit",
    "pretest": "npm run dashboard:build",
    "pretest:fast": "npm run dashboard:build",
    "prepack": "npm run dashboard:build",
    "test": "node --test \"test/*.test.js\" \"test/e2e/*.test.js\"",
    "test:fast": "node --test \"test/*.test.js\"",
    "validate": "node scripts/validate.mjs --portable",
    "validate:portable": "node scripts/validate.mjs --portable",
    "validate:full": "node scripts/validate.mjs --full",
    "pack:dry": "npm pack --dry-run",
    "prepublishOnly": "npm test",
    "eval": "node scripts/eval-routing.mjs",
    "eval:quality": "node scripts/eval-quality.mjs"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "opencode",
    "copilot",
    "github-copilot",
    "agents",
    "subagents",
    "ai",
    "code-review",
    "architecture"
  ],
  "author": "Erika Lira",
  "license": "MIT",
  "homepage": "https://github.com/erikalira/canonkit#readme",
  "bugs": {
    "url": "https://github.com/erikalira/canonkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erikalira/canonkit.git"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "prompts": "2.4.2"
  },
  "devDependencies": {
    "@types/prompts": "^2.4.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "@xyflow/react": "12.12.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "6.4.6"
  }
}
