{
  "name": "canonkit",
  "version": "2.0.0",
  "description": "A versioned agent team for Claude Code, Codex and OpenCode. Installs 10 core agents and 5 opt-in domain specialists, each owning a domain and classifying its own risk.",
  "type": "module",
  "bin": {
    "canonkit": "bin/cli.js"
  },
  "files": [
    "bin",
    "agents",
    "reference",
    "hooks",
    "dashboard",
    "skills",
    "tools",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "validate": "bash scripts/validate.sh",
    "pack:dry": "npm pack --dry-run",
    "prepublishOnly": "npm test",
    "eval": "node scripts/eval-routing.mjs",
    "eval:quality": "node scripts/eval-quality.mjs"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "opencode",
    "agents",
    "subagents",
    "ai",
    "code-review",
    "architecture"
  ],
  "author": "Erika Lira",
  "license": "MIT",
  "homepage": "https://github.com/erikalira/canonkit#readme",
  "bugs": {
    "url": "https://github.com/erikalira/canonkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erikalira/canonkit.git"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "prompts": "2.4.2"
  },
  "devDependencies": {
    "@types/prompts": "^2.4.9"
  }
}
